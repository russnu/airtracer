generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

//==========================================================================//
// ENUMS
//==========================================================================//

enum Event {
  // Asset
  ASSET_CREATED
  ASSET_UPDATED
  ASSET_ASSIGNED
  ASSET_OWNERSHIP_CHANGED
  ASSET_DEACTIVATED

  // Service Record
  SERVICE_RECORD_CREATED
  SERVICE_RECORD_UPDATED
  SERVICE_RECORD_COMPLETED
  SERVICE_RECORD_CANCELLED

  // QR Code
  QR_GENERATED
  QR_REGENERATED
  QR_DEACTIVATED

  // Service Photos
  SERVICE_PHOTO_ADDED
  SERVICE_PHOTO_REMOVED
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

//==========================================================================//
// MODELS
//==========================================================================//
model User {
  id String @id @default(cuid())

  // Authentication
  email        String @unique
  passwordHash String

  // Personal Information
  firstName   String
  lastName    String
  phoneNumber String?

  // RBAC
  roles UserRole[]

  // Account Status
  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  // Security
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  serviceRecords ServiceRecord[]
  assetsOwned    Asset[]
  auditLogs      AuditLog[]
}

//==========================================================================//
model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

//==========================================================================//
model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//==========================================================================//
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

//==========================================================================//
model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

//==========================================================================//
model EquipmentType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  // Account Status
  isActive Boolean @default(true)

  // Relations
  assets Asset[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//==========================================================================//
model Asset {
  id String @id @default(cuid())

  // Asset Identification
  qrCode QRCode?

  // Equipment Information
  brand        String
  model        String
  serialNumber String? @unique
  isActive     Boolean @default(true)
  // Equipment Classification

  equipmentTypeId String
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])

  // refrigerant   String?
  // capacity      Float?
  // capacityUnit  String?

  // Installation Information
  installationDate DateTime?
  location         String?

  // Ownership
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  // Maintenance
  serviceRecords ServiceRecord[]

  // Audit
  auditLogs AuditLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([ownerId])
  @@index([equipmentTypeId])
  @@index([brand, model])
}

//==========================================================================//
model QRCode {
  id String @id @default(cuid())

  // Public identifier encoded inside the QR
  token String @unique

  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  generatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
}

//==========================================================================//
model ServiceRecord {
  id String @id @default(cuid())

  // Asset
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  // Technician
  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id])

  // Service Information
  serviceDate DateTime
  serviceType String
  description String?
  status      ServiceStatus @default(PENDING)

  // Operating Measurements
  suctionPressure   Float?
  dischargePressure Float?

  current Float?
  voltage Float?

  // Condition / Findings
  findings        String?
  recommendations String?

  // Service Photos 
  photos ServicePhoto[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([technicianId])
  @@index([serviceDate])
}

//==========================================================================//

model ServicePhoto {
  id String @id @default(cuid())

  //Service Record 
  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  // File Information
  fileName   String
  storageKey String
  mimeType   String?
  fileSize   Int?

  // Photo Information
  caption String?

  // Audit
  uploadedAt DateTime @default(now())

  @@index([serviceRecordId])
}

//==========================================================================//
model AuditLog {
  id String @id @default(cuid())

  // Who performed the event
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // What happened
  event Event

  // What asset's lifecycle this event belongs to
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Event data
  payload Json?

  // Tamper-evident hash chain
  previousHash String?
  hash         String  @unique

  // Timestamp
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([event])
  @@index([assetId, createdAt])
  @@index([createdAt])
}
