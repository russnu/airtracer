# Copy to .env for development. The db:* scripts read this file.
# The seeder refuses a non-localhost DATABASE_URL unless run with
# --allow-remote, which the db:seed scripts pass.

# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Port the API listens on.
PORT=3000

# Secret used to sign access tokens, and how long a token stays valid.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Origin of the PWA that serves /qr/:token. It is encoded in QR codes,
# printed labels, and shared links, so in production it must be the
# long-term public PWA domain.
QR_BASE_URL=http://localhost:5173

# Comma-separated PWA origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173

# Supabase project for service photos (bucket "service-photos").
# The secret key is server-only; never put it in the PWA.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
