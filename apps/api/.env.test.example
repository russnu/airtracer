# Copy to .env.test for the local test database. Used by test:e2e,
# test:db:*, dev:test-db and db:migration:new.
# Supabase placeholders are enough: the e2e tests never write to storage.

DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/airtracer_test?schema=public"
PORT=3000
JWT_SECRET=test-secret
JWT_EXPIRES_IN=7d
QR_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
